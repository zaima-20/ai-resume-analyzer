# Example Streamlit secrets. On Streamlit Community Cloud, paste these lines
# (with your real values) into the app's Settings > Secrets box.
# For a local secrets file instead, copy this to .streamlit/secrets.toml,
# which is git-ignored. Never commit the real file.
#
# Keys must stay at the top level (no [section] headers), in quotes.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY = "your_gemini_api_key_here"

# RapidAPI key for JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY = "your_rapidapi_key_here"

# Adzuna (https://developer.adzuna.com/)
ADZUNA_APP_ID = "your_adzuna_app_id_here"
ADZUNA_APP_KEY = "your_adzuna_app_key_here"

# Supabase (Project Settings > API). Use the anon / publishable key,
# NEVER the service_role / secret key: that one bypasses all security rules.
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your_supabase_anon_key_here"
